# --- Data (rule 1 in CLAUDE.md: never version it) ---
ml/data/
*.mp4
*.mov
*.avi
*.mkv

# --- Large models / training artifacts ---
ml/models/*.tflite
ml/models/*.pt
ml/models/*.pth
ml/models/*.onnx
ml/models/*.h5
ml/models/*.keras
ml/runs/
ml/checkpoints/
# C arrays exported for the firmware may be versioned (they are small);
# if one grows past ~200 KB, add it here.

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# --- Firmware (Zephyr / west) ---
firmware/**/build/
firmware/.west/
firmware/zephyr/
firmware/nrf/
firmware/modules/
firmware/bootloader/

# --- Node / backend ---
node_modules/
dist/
.env
.env.*
!.env.example

# --- Flutter ---
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# --- Hardware ---
hardware/pcb/**/*-backups/
hardware/pcb/**/fp-info-cache
hardware/pcb/**/*.lck

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
