# --- Dados (regra 1 do CLAUDE.md: nunca versionar) ---
ml/data/
*.mp4
*.mov
*.avi
*.mkv

# --- Modelos grandes / artefatos de treino ---
ml/models/*.tflite
ml/models/*.pt
ml/models/*.pth
ml/models/*.onnx
ml/models/*.h5
ml/models/*.keras
ml/runs/
ml/checkpoints/
# arrays C exportados para o firmware podem ser versionados (são pequenos);
# se algum passar de ~200 KB, adicionar aqui.

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# --- Firmware (Zephyr / west) ---
firmware/**/build/
firmware/.west/
firmware/zephyr/
firmware/nrf/
firmware/modules/
firmware/bootloader/

# --- Node / backend ---
node_modules/
dist/
.env
.env.*
!.env.example

# --- Flutter ---
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# --- Hardware ---
hardware/pcb/**/*-backups/
hardware/pcb/**/fp-info-cache
hardware/pcb/**/*.lck

# --- SO / editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/
