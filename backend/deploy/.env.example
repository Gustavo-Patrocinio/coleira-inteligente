# Copy to .env next to docker-compose.yml (never commit .env).
# Public DNS name pointing at this server (A/AAAA record), e.g. collar.example.com
DOMAIN=collar.example.com
# Long random strings: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Baseline/alerts job interval in minutes (0 = off)
ALERTS_EVERY_MIN=60
# Email for password reset codes (DEPLOY.md, Email; optional). Any SMTP provider:
# SMTP_URL=smtps://<user>:<password>@<smtp host>:465   (URL-encode special characters)
SMTP_URL=
MAIL_FROM=Smart Collar <no-reply@example.com>
# Off-site encrypted backups (DEPLOY.md, step 5; optional, needs --profile offsite)
# Passphrase that encrypts the dumps before upload: keep a copy OUTSIDE this server
# (password manager). Without it the off-site backups cannot be restored.
BACKUP_PASSPHRASE=
# S3-compatible storage. Oracle Cloud: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Keep in line with the privacy policy (docs/privacy-policy.md: backups kept 14 days)
OFFSITE_KEEP_DAYS=14
