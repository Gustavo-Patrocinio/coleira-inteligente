{
  "name": "collar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Smart dog collar backend: ingestion, per-dog baseline and alerts (Phase 4)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "job:alerts": "tsx --env-file-if-exists=.env src/scripts/run-alerts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "10.2.8",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
