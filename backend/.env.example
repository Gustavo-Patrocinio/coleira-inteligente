# Copy to .env (never commit .env)
DATABASE_URL=postgres://collar:collar@localhost:54329/collar
JWT_SECRET=change-me-to-a-long-random-string
# 0.0.0.0 = reachable from the LAN (the phone); 127.0.0.1 = this machine only
HOST=0.0.0.0
PORT=3000
# Run the baseline/alerts job inside the server every N minutes (0 = off)
ALERTS_EVERY_MIN=60
